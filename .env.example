# 环境变量模板：复制为 .env 后填写（.env 已被 .gitignore 忽略，不要提交真实密钥）
#   cp .env.example .env
# 默认只需要填 DEEPSEEK_API_KEY；离线 Mock 模式（--mock）不需要任何变量。

# ===== 模型提供方 =====
# deepseek（默认，已验证）| siliconflow | dashscope | moonshot | openai | openai_compat
LLM_PROVIDER=deepseek
# 各提供方的密钥（只填用到的那个）
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
OPENAI_API_KEY=
# 可选覆盖：模型名 / 接口地址 / 通用密钥（openai_compat 必填 LLM_BASE_URL 与 LLM_MODEL）
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
# 思考模式：enabled / disabled；思考强度：low / high / max（提供方不支持时自动忽略）
LLM_THINKING=enabled
LLM_REASONING_EFFORT=high
# 单次请求超时（秒）
LLM_TIMEOUT=60

# ===== 检索 =====
# bm25（默认）| vector | hybrid（BM25 + 向量，RRF 融合）
RETRIEVER=bm25
# 向量化：openai_compat（默认硅基流动 bge-m3，密钥可复用 SILICONFLOW_API_KEY）| hash（离线，无语义，只验证流程）
EMBEDDING_PROVIDER=openai_compat
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=
# 向量存储：memory（默认，零部署）| milvus
VECTOR_STORE=memory
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=kbqa_sections
# 向量相似度下限（低于此值的结果丢弃）与 RRF 融合参数
VECTOR_MIN_SCORE=0
RRF_K=60

# ===== Agent 预算 =====
AGENT_MAX_LLM_TURNS=8
AGENT_MAX_TOOL_CALLS=12
