# 环境变量模板：复制为 .env 后填写（.env 已被 .gitignore 忽略，不要提交真实密钥）
#   cp .env.example .env
# 只有 DEEPSEEK_API_KEY 必填；离线 Mock 模式（--mock）无需任何变量。

# ===== DeepSeek 官方接口 =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 思考模式：enabled / disabled
DEEPSEEK_THINKING=enabled
# 思考强度：low / high / max
DEEPSEEK_REASONING_EFFORT=high
# 单次请求超时（秒）
LLM_TIMEOUT=60

# ===== Agent 预算 =====
AGENT_MAX_LLM_TURNS=8
AGENT_MAX_TOOL_CALLS=12
